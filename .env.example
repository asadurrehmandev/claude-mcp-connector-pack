# Copy to .env for a local process. The demo values are public and are refused in live mode.

SWITCHBOARD_ENV=demo
SWITCHBOARD_HOST=127.0.0.1
SWITCHBOARD_PORT=4317
SWITCHBOARD_PUBLIC_BASE_URL=http://127.0.0.1:4317
# Live mode requires 32+ characters and must not be the demo secret.
# SWITCHBOARD_SIGNING_SECRET=
SWITCHBOARD_RATE_LIMIT=60
SWITCHBOARD_RATE_WINDOW=60
SWITCHBOARD_AUDIT_PATH=var/audit.jsonl
SWITCHBOARD_POLICY_PATH=var/policy.json

# OAuth client. Demo mode fills the secret when this is empty.
SWITCHBOARD_OAUTH_CLIENT_ID=fernwood-console
# SWITCHBOARD_OAUTH_CLIENT_SECRET=

# stdio only. HTTP takes the tenant from the bearer token.
# SWITCHBOARD_TENANT_ID=halden-bikes
# SWITCHBOARD_SCOPES=crm.read,crm.write,ads.read,docs.read,projects.read,projects.write,slack.read,slack.write
# SWITCHBOARD_ACTOR=elena.voss@fernwood.studio

# Leave these empty to stay on the mock backends.
# HUBSPOT_ACCESS_TOKEN=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_ACCESS_TOKEN=
# GOOGLE_ADS_CUSTOMER_MAP={"halden-bikes":"1234567890"}
# META_ADS_ACCESS_TOKEN=
# META_AD_ACCOUNT_MAP={"halden-bikes":"act_111"}
# NOTION_TOKEN=
# NOTION_PAGE_MAP={"halden-bikes":["page-id"]}
# CLICKUP_TOKEN=
# CLICKUP_LIST_MAP={"halden-bikes":"list-id"}
# SLACK_BOT_TOKEN=
# SLACK_ALLOWLIST={"halden-bikes":["#client-halden"]}

# Console (browser). The default in the Next app is this URL.
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:4317/console
